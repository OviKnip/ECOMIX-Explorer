leaflet() %>%
addTiles() %>%
setView(lng = -1.16, lat = 53.75, zoom = 8.5) %>%
addPolygons(data=shp_map, aes(fill = p50_ensemble))
leaflet() %>%
addTiles() %>%
setView(lng = -1.16, lat = 53.75, zoom = 8.5) %>%
addPolygons(data=shp_map, fill = p50_ensemble)
pal <- colorNumeric(
