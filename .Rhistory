# Restructure data to parquet databases for better file loading
library(arrow)
library(dplyr)
# path to Aggregated output
path_agg_output <- "D:/GITHUB/ECOMIX_Explorer/preprocessing/aggregations/"
# path to database
path_db <- "D:/GITHUB/ECOMIX_Explorer/ECOMIX-Explorer/data/"
### 1. Projections ###
# Yearly
infile <- paste0(path_agg_output, "Projections_Year_Agg.gz.parquet")
df_data <- read_parquet(infile)
head(df_data)
db_name <- paste0(path_db, "DB_Proj_Year")
df_data %>% group_by(subbasin, hype_variable, ssp) %>% write_dataset(db_name)
# monthly
infile <- paste0(path_agg_output, "Projections_Month_Agg.gz.parquet")
df_data <- read_parquet(infile)
head(df_data)
db_name <- paste0(path_db, "DB_Proj_Month")
df_data %>% group_by(subbasin, hype_variable, ssp, period) %>% write_dataset(db_name)
# Percentiles (also reduce the stored percentiles a bit, this data is huge)
infile <- paste0(path_agg_output, "Projections_percentile_Agg.gz.parquet")
df_data <- read_parquet(infile)
head(df_data)
db_name <- paste0(path_db, "DB_Proj_Percentiles")
df_data %>% group_by(subbasin, hype_variable, ssp, period) %>% write_dataset(db_name)
# Define path of the project
path <- "D:/GITHUB/ECOMIX_Explorer/ECOMIX-Explorer/"
setwd(path)
