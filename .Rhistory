### 5. Water quality during Floods ###
######################################
# !!!!!Check the flood day files because
# the timing histogram looks different to the
# AMAX timing histogram
# Load database
subbasin_subset <-  df_subbasin_subset$id_subbasin[df_subbasin_subset$class == "Downstream"]
db_name <- paste0(path_db, "DB_Floods_WQ")
df_floods_wq <- open_dataset(db_name) %>%
filter(id_subbasin %in% subbasin_subset,
rel_date >= 0,
eval_period %in% c("2000_2020", "2060_2080")) %>%
collect()
# data wrangling
#df_floods_wq$id_subbasin <- as.numeric(as.character(df_floods_wq$id_subbasin))
df_floods_wq$date <- as.Date(df_floods_wq$date)
df_floods_wq$month <- lubridate::month(df_floods_wq$date)
df_floods_wq$year <- lubridate::year(df_floods_wq$date)
df_tmp <- head(df_floods_wq)
# remove the first year of each decade
df_floods_wq <- df_floods_wq %>%
filter(!year %in% c(2030,2040,2050,2060,2070))
# create a backup
#df_floods_wq_bu <- df_floods_wq
df_floods_wq <- df_floods_wq_bu
# create a backup
df_floods_wq_bu <- df_floods_wq
# Get from seasonal max to AMAX
df_floods_wq$event_date <- df_floods_wq$date - df_floods_wq$rel_date
df_tmp <- df_amax %>% ungroup() %>% dplyr::select(date, year, ssp, ssp_label, cm, hydro_run, eval_period, period_label, id_subbasin, subbasin_label)
df_floods_wq <- df_floods_wq %>% dplyr::select(-date)
df_floods_wq <- left_join(df_floods_wq, df_tmp, by = c("event_date" = "date",  "year", "ssp", "cm", "hydro_run", "eval_period", "id_subbasin"))
df_floods_wq <- df_floods_wq[!is.na(df_floods_wq$ssp_label), ]
# Get max concetration of the event (+4days)
df_floods_wq <- df_floods_wq %>%
group_by(ssp, ssp_label, eval_period, period_label, cm, hydro_run, id_subbasin, subbasin_label, year, event_date) %>%
summarise("discharge" = max(discharge), "IN" = max(IN) / 1000, "SP" = max(SP) / 1000, "SS" = max(SS), "OC" = max(OC))
df_floods_wq_events <- reshape2::melt(df_floods_wq,
id.vars = c("ssp", "ssp_label", "eval_period", "period_label", "cm", "hydro_run",
"id_subbasin", "subbasin_label", "event_date", "year","discharge")) %>%
rename("substance" = variable)
unique(df_floods_wq_events$substance)
df_floods_wq_events$month <- lubridate::month(df_floods_wq_events$event_date)
df_floods_wq_events$week <- lubridate::week(df_floods_wq_events$event_date)
df_floods_wq_events$doy <- lubridate::yday(df_floods_wq_events$event_date)
